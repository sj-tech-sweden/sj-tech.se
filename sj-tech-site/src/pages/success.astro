---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Meddelande skickat | SJ-Tech">
  <section class="py-20 px-4 max-w-2xl mx-auto text-center">
    <div class="bg-slate-900 p-10 rounded-2xl border border-slate-800 shadow-lg">
      <h1 class="text-3xl font-bold text-white mb-4">Tack!</h1>
      <p class="text-slate-400 text-lg mb-8">Ditt meddelande har skickats. Vi återkommer så snart som möjligt.</p>
      <a href="/" class="inline-block bg-brand-600 hover:bg-brand-500 text-white font-medium px-8 py-3 rounded-lg transition">
        Tillbaka till startsidan
      </a>
    </div>
  </section>
</Layout>
