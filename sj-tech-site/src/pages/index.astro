---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ContactSection from '../components/ContactSection.astro';
import { Image } from 'astro:assets';

import heroImage from '../assets/DSC_0218-scaled.webp';
import gallery1 from '../assets/DSC_0231-scaled.webp';
import gallery2 from '../assets/DSC_0244-e1518422339369.webp';
import gallery3 from '../assets/DSC_0253-scaled.webp';
import gallery4 from '../assets/DSC_0263-scaled.webp';
import gallery5 from '../assets/DSC_6060-1-scaled.webp';
import gallery6 from '../assets/cropped-DSC_1263-1-scaled.webp';
---

<Layout>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-32 px-4 overflow-hidden border-b border-slate-800">
    <Image
      src={heroImage}
      alt="Teknisk produktion på ett evenemang"
      width={1920}
      height={1289}
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-slate-900/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto text-center">
    <!-- Status Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-semibold uppercase tracking-wider mb-8">
      <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span>
      Evenemangs- & Nätverksteknik
    </div>

    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
      Kopplar samman <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-brand-300">evenemang</span>, <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-brand-300">video</span> och <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-brand-300">IT</span>
    </h1>
    
    <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto mb-10 leading-relaxed">
      Vi levererar nyckelfärdiga lösningar för temporär nätverksinfrastruktur, liveströmning och teknisk produktion vid konferenser, mässor och evenemang.
    </p>

    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a href="#contact-section" class="bg-brand-600 hover:bg-brand-500 text-white font-medium px-8 py-3.5 rounded-lg shadow-lg shadow-brand-600/20 transition">
        Kontakta oss
      </a>
      <a href="#services" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-medium px-8 py-3.5 rounded-lg transition">
        Utforska tjänster
      </a>
    </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="py-20 bg-slate-950/60 border-b border-slate-800/80">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-white mb-4">Från våra uppdrag</h2>
        <p class="text-slate-400">Ett urval av tekniska lösningar vi levererat vid konferenser, mässor och evenemang.</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {[gallery1, gallery2, gallery3, gallery4, gallery5, gallery6].map((image) => (
          <Image
            src={image}
            alt="Bild från ett SJ-Tech uppdrag"
            width={640}
            height={427}
            class="w-full h-48 object-cover rounded-xl border border-slate-800 hover:border-brand-500/50 transition"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Core Services Grid -->
  <section id="services" class="py-20 bg-slate-950/60 border-y border-slate-800/80">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-white mb-4">Våra Huvudområden</h2>
        <p class="text-slate-400">Från stabil uppkoppling i utmanande miljöer till komplett bild- och ljudproduktion.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <ServiceCard 
          title="IT & Tillfälligt Nätverk" 
          description="Driftsäkert WiFi, routeruppsättningar och redundanta nätverk för event, mässor och tillfälliga kontor där avbrott inte är ett alternativ."
          icon="🌐"
        />
        <ServiceCard 
          title="Video & Liveströmning" 
          description="Flerkameraproduktion, bildmixning och stabil sändning till webb eller interna plattformar med professionell grafikanpassning."
          icon="📹"
        />
        <ServiceCard 
          title="Evenemangsteknik" 
          description="Helhetsansvar för ljud, ljus, scen- och visningsteknik. Vi ser till att allt fungerar från planering till genomförande."
          icon="⚡"
        />
      </div>
    </div>
  </section>

  <!-- Value / Features Section -->
  <section class="py-20 max-w-6xl mx-auto px-4">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold text-white mb-6">Varför SJ-Tech?</h2>
        <ul class="space-y-4 text-slate-300">
          <li class="flex items-start gap-3">
            <span class="text-brand-400 font-bold">✓</span>
            <span><strong>Redundans & Säkerhet:</strong> Vi bygger nätverk och streamingsystem med fokus på hög tillgänglighet och felsäkra lösningar.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-400 font-bold">✓</span>
            <span><strong>Teknisk Bredd:</strong> Samma partner hanterar både IP-nätverket och bildmixern – vilket minskar gränsytor och strul.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-400 font-bold">✓</span>
            <span><strong>Skräddarsytt:</strong> Anpassade uppsättningar oavsett om det gäller ett mindre hybridmöte eller en storskalig konferens.</span>
          </li>
        </ul>
      </div>

      <div class="bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-700/60 p-8 rounded-2xl shadow-xl">
        <h3 class="text-xl font-semibold text-white mb-2">Behöver du teknik till ditt nästa event?</h3>
        <p class="text-slate-400 text-sm mb-6">Vi hjälper dig att kartlägga behoven och ta fram en stabil teknisk lösning.</p>
        <a href="#contact-section" class="inline-block w-full text-center bg-brand-600 hover:bg-brand-500 text-white font-medium py-3 rounded-lg transition">
          Diskutera ditt projekt
        </a>
      </div>
    </div>
  </section>

  <!-- Integrated Contact Section -->
  <ContactSection />
</Layout>