---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const {
  title = "SJ-Tech | Kopplar samman evenemang, video och IT",
  description = "Specialisttjänster inom IT-nätverk, live-video och tekniska eventlösningar.",
  activePath = '',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="sv" class="bg-slate-900 text-slate-100 font-sans antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header activePath={activePath} />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
