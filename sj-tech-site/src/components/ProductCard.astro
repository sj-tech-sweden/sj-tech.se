---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const formattedPrice = new Intl.NumberFormat('sv-SE', {
  style: 'currency',
  currency: 'SEK',
  maximumFractionDigits: 0,
}).format(product.price);
---

<div class="bg-slate-800/50 border border-slate-700/60 p-6 rounded-xl hover:border-brand-500/50 transition flex flex-col">
  <div class="flex items-start justify-between gap-3 mb-3">
    <span class="text-xs font-semibold uppercase tracking-wider text-brand-400">{product.category}</span>
    <span
      class:list={[
        'text-xs font-medium px-2 py-1 rounded-full',
        product.inStock
          ? 'bg-green-500/10 text-green-400'
          : 'bg-red-500/10 text-red-400',
      ]}
    >
      {product.inStock ? 'I lager' : 'Slut i lager'}
    </span>
  </div>
  <h3 class="text-xl font-semibold mb-2 text-white">{product.name}</h3>
  <p class="text-slate-400 text-sm leading-relaxed mb-4 flex-grow">{product.description}</p>
  <p class="text-lg font-bold text-white">{formattedPrice}</p>
</div>
