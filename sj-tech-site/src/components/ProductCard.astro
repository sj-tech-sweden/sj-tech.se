---
import { getImageUrl, type RentalProduct } from '../data/products';

interface Props {
  product: RentalProduct;
}

const { product } = Astro.props;
const image = product.images[0];
---

<div class="bg-slate-800/50 border border-slate-700/60 rounded-xl overflow-hidden hover:border-blue-500/50 transition">
  {image && (
    <img
      src={getImageUrl(image)}
      alt={product.name}
      loading="lazy"
      class="w-full h-48 object-cover bg-slate-900"
    />
  )}

  <div class="p-6">
    <h3 class="text-xl font-semibold text-white mb-1">{product.name}</h3>
    {product.brand && <p class="text-sm text-slate-400">{product.brand}</p>}
  </div>
</div>
